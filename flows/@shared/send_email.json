{
  "$schema": "../../schemas/flow.schema.json",
  "name": "Send Email Notification Component",
  "description": "Reusable shared subflow component for sending email notifications via Gmail / SMTP",
  "version": "1.0.0",
  "variables": {
    "to": "arttopix@example.com",
    "subject": "Automated Notification from Kinenix",
    "body": "Hello, this is an automated message from Kinenix.",
    "html": null,
    "attachments": [],
    "dry_run": false
  },
  "steps": [
    {
      "id": "step_send_email",
      "name": "Send Email Message",
      "action": "email.send",
      "parameters": {
        "to": "${to}",
        "subject": "${subject}",
        "body": "${body}",
        "html": "${html}",
        "attachments": "${attachments}",
        "dry_run": "${dry_run}"
      },
      "output_var": "send_result"
    },
    {
      "id": "step_return_status",
      "name": "Return Email Result",
      "action": "flow.return",
      "parameters": {
        "value": {
          "status": "${send_result.status}",
          "channel": "${send_result.channel}",
          "to": "${to}",
          "subject": "${subject}",
          "timestamp": "${send_result.timestamp}"
        }
      }
    }
  ]
}