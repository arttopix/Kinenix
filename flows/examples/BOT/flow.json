{
  "$schema": "../../../schemas/flow.schema.json",
  "name": "Bank of Thailand Exchange Rates Collector",
  "description": "Automate collecting historical foreign exchange rates (USD, GBP, SGD, JPY, EUR) for December 2024 from the Bank of Thailand (BOT) website, export to grouped Excel, and email to recipient.",
  "version": "1.0.0",
  "variables": {
    "exchange_rate_records": []
  },
  "steps": [
    {
      "id": "step_1",
      "name": "Open Bank of Thailand Exchange Rate Portal",
      "action": "web.open",
      "parameters": {
        "url": "${config.bot_url}",
        "headless": "${config.headless}",
        "timeout": 30000,
        "on_error": "retry",
        "max_retries": 2,
        "retry_interval": 3.0
      }
    },
    {
      "id": "step_2",
      "name": "Check Cookie Consent Banner Visibility",
      "action": "web.is_visible",
      "parameters": {
        "selector": "button:has-text('Accept recommended cookies'), button:has-text('Proceed with necessary cookies')",
        "timeout": 2000,
        "on_error": "continue"
      },
      "output_var": "has_cookie_banner"
    },
    {
      "id": "step_3",
      "name": "Decide Cookie Consent Action",
      "action": "ai.decide",
      "parameters": {
        "state": "ต้องการยินยอมรับคุกกี้เพื่อเปิดดูตารางอัตราแลกเปลี่ยนและให้เว็บไซต์ทำงานได้สมบูรณ์",
        "question": {
          "name": "consent_button",
          "type": "choice",
          "instructions": "เลือกปุ่มที่เหมาะสมที่สุดในการกดยอมรับคุกกี้เพื่อเข้าใช้งานเว็บไซต์",
          "options": [
            "Accept recommended cookies",
            "Proceed with necessary cookies"
          ]
        },
        "on_error": "continue"
      },
      "output_var": "cookie_decision",
      "condition": "${has_cookie_banner} == true"
    },
    {
      "id": "step_4",
      "name": "Click Cookie Consent Button",
      "action": "web.click",
      "parameters": {
        "selector": "button:has-text('${cookie_decision.choice}')",
        "timeout": 3000,
        "optional": true,
        "on_error": "continue"
      },
      "condition": "${has_cookie_banner} == true"
    },
    {
      "id": "step_5",
      "name": "Wait for Portal Content and Table to Load",
      "action": "web.wait_for",
      "parameters": {
        "selector": "div.table-responsive, table, select",
        "state": "visible",
        "timeout": 15000,
        "on_error": "continue"
      }
    },
    {
      "id": "step_6",
      "name": "Loop Through Target Currencies",
      "action": "logic.loop",
      "parameters": {
        "items": "${config.currencies}",
        "item_var": "currency"
      },
      "sub_steps": [
        {
          "id": "sub_step_6_1",
          "name": "Select Target Currency from Dropdown",
          "action": "web.select_option",
          "parameters": {
            "selector": "select#currency, select[name*='currency'], select",
            "text": "${currency}",
            "ai_match": true,
            "on_error": "retry",
            "max_retries": 2
          }
        },
        {
          "id": "sub_step_6_2",
          "name": "Set Historical Start Date",
          "action": "web.type",
          "parameters": {
            "selector": "input#startDate, input[name*='startDate'], input[placeholder*='Start']",
            "text": "${config.start_date}"
          }
        },
        {
          "id": "sub_step_6_3",
          "name": "Set Historical End Date",
          "action": "web.type",
          "parameters": {
            "selector": "input#endDate, input[name*='endDate'], input[placeholder*='End']",
            "text": "${config.end_date}"
          }
        },
        {
          "id": "sub_step_6_4",
          "name": "Click Search or Apply Button",
          "action": "web.click",
          "parameters": {
            "selector": "button:has-text('Search'), button:has-text('Apply'), input[type='submit']"
          }
        },
        {
          "id": "sub_step_6_5",
          "name": "Wait for Exchange Rate Table Update",
          "action": "web.wait_for",
          "parameters": {
            "timeout": 3000
          }
        },
        {
          "id": "sub_step_6_6",
          "name": "Extract Transfer Rate Data from Table",
          "action": "web.get_text",
          "parameters": {
            "selector": "table tbody, div.table-responsive"
          },
          "output_var": "raw_table_text"
        },
        {
          "id": "sub_step_6_7",
          "name": "Append Currency Transfer Rate Record",
          "action": "logic.append",
          "parameters": {
            "target": "exchange_rate_records",
            "item": {
              "currency": "${currency}",
              "start_date": "${config.start_date}",
              "end_date": "${config.end_date}",
              "table_data": "${raw_table_text}"
            }
          }
        }
      ]
    },
    {
      "id": "step_7",
      "name": "Write Grouped Transfer Rates to Excel",
      "action": "excel.write",
      "parameters": {
        "file_path": "${config.excel_output_path}",
        "data": "${exchange_rate_records}",
        "on_error": "retry",
        "max_retries": 2
      }
    },
    {
      "id": "step_8",
      "name": "Capture Execution Proof Screenshot",
      "action": "web.screenshot",
      "parameters": {
        "path": "${config.screenshot_path}",
        "full_page": true,
        "on_error": "continue"
      }
    },
    {
      "id": "step_9",
      "name": "Close Browser Session",
      "action": "web.close",
      "parameters": {}
    },
    {
      "id": "step_10",
      "name": "Send Exchange Rates Report Email via Outlook/SMTP",
      "action": "flow.call",
      "parameters": {
        "flow": "@shared/send_email.json",
        "inputs": {
          "to": "${config.email_recipient}",
          "subject": "${config.email_subject}",
          "body": "Hello,\n\nPlease find attached the Bank of Thailand Foreign Exchange Rates report (USD, GBP, SGD, JPY, EUR) for the period 01-12-2024 to 31-12-2024.\n\nBest regards,\nBatAutomate Worker",
          "attachments": [
            "${config.excel_output_path}"
          ],
          "dry_run": "${config.dry_run}"
        },
        "on_error": "continue"
      },
      "output_var": "email_delivery_result",
      "condition": "${config.send_email} == true"
    }
  ]
}
