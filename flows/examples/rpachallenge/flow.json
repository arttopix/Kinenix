{
  "$schema": "../../../schemas/flow.schema.json",
  "name": "RPA Challenge Solver",
  "description": "Self-Contained Project Bundle: Automate filling RPA Challenge form (10 rounds, 70 fields) from local bundle assets",
  "version": "1.0.0",
  "variables": {
    "non_programmers": []
  },
  "steps": [
    {
      "id": "step_1",
      "name": "Open RPA Challenge Webpage #EDIT for check",
      "action": "web.open",
      "parameters": {
        "url": "${config.website}",
        "headless": false
      }
    },
    {
      "id": "step_2",
      "name": "Read Challenge Excel File",
      "action": "excel.read",
      "parameters": {
        "file_path": "${config.excel_path}",
        "clean_headers": true
      },
      "output_var": "challenge_data"
    },
    {
      "id": "step_3",
      "name": "Click START Button to Begin Timer",
      "action": "web.click",
      "parameters": {
        "selector": "button:has-text('Start')"
      }
    },
    {
      "id": "step_4",
      "name": "Loop Through 10 Rows and Process Roles",
      "action": "logic.loop",
      "parameters": {
        "items": "${challenge_data}",
        "item_var": "row"
      },
      "sub_steps": [
        {
          "id": "sub_check_programmer",
          "name": "Check If Role in Company is Programmer",
          "action": "logic.if",
          "parameters": {
            "left": "${row.Role in Company}",
            "operator": "equals",
            "right": "Programmer"
          },
          "sub_steps": [
            {
              "id": "sub_4_1",
              "name": "Fill First Name",
              "action": "web.type",
              "parameters": {
                "label": "First Name",
                "text": "${row.First Name}"
              }
            },
            {
              "id": "sub_4_2",
              "name": "Fill Last Name",
              "action": "web.type",
              "parameters": {
                "label": "Last Name",
                "text": "${row.Last Name}"
              }
            },
            {
              "id": "sub_4_3",
              "name": "Fill Company Name",
              "action": "web.type",
              "parameters": {
                "label": "Company Name",
                "text": "${row.Company Name}"
              }
            },
            {
              "id": "sub_4_4",
              "name": "Fill Role in Company",
              "action": "web.type",
              "parameters": {
                "label": "Role in Company",
                "text": "${row.Role in Company}"
              }
            },
            {
              "id": "sub_4_5",
              "name": "Fill Address",
              "action": "web.type",
              "parameters": {
                "label": "Address",
                "text": "${row.Address}"
              }
            },
            {
              "id": "sub_4_6",
              "name": "Fill Email",
              "action": "web.type",
              "parameters": {
                "label": "Email",
                "text": "${row.Email}"
              }
            },
            {
              "id": "sub_4_7",
              "name": "Fill Phone Number",
              "action": "web.type",
              "parameters": {
                "label": "Phone Number",
                "text": "${row.Phone Number}"
              }
            },
            {
              "id": "sub_4_8",
              "name": "Submit Form Round",
              "action": "web.click",
              "parameters": {
                "selector": "//input[@value='Submit']"
              }
            }
          ],
          "else_steps": [
            {
              "id": "sub_4_else_collect",
              "name": "Collect Non-Programmer into DataTable",
              "action": "logic.append",
              "parameters": {
                "target": "non_programmers",
                "item": {
                  "First Name": "${row.First Name}",
                  "Role in Company": "${row.Role in Company}"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "step_5",
      "name": "Take Screenshot of Result",
      "action": "web.screenshot",
      "parameters": {
        "path": "${config.screenshot_path}"
      }
    },
    {
      "id": "step_6",
      "name": "Close Browser",
      "action": "web.close",
      "parameters": {}
    },
    {
      "id": "step_7",
      "name": "Send Email Notification via Gmail",
      "action": "flow.call",
      "condition": "${config.send_notification} == true",
      "parameters": {
        "flow": "@shared/send_email.json",
        "inputs": {
          "to": "${config.email_to}",
          "subject": "${config.email_subject}",
          "body": "Hello,\n\nThe RPA Challenge benchmark automation has completed successfully.\nNon-programmers collected: ${non_programmers}\n\nPlease find attached the result screenshot.",
          "attachments": [
            "${config.screenshot_path}"
          ],
          "dry_run": "${config.dry_run}"
        }
      },
      "output_var": "email_notification_result"
    }
  ]
}
