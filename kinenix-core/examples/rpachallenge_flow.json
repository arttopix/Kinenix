{
  "name": "RPA Challenge Solver",
  "description": "Automate filling RPA Challenge form (10 rounds, 70 fields) from challenge.xlsx with dynamic layout",
  "version": "1.0.0",
  "variables": {
    "target_url": "https://rpachallenge.com/",
    "excel_path": "examples/challenge.xlsx",
    "screenshot_path": "examples/result_rpachallenge.png"
  },
  "steps": [
    {
      "id": "step_1",
      "name": "Open RPA Challenge Webpage",
      "action": "web.open",
      "parameters": {
        "url": "${target_url}",
        "headless": true
      }
    },
    {
      "id": "step_2",
      "name": "Read Challenge Excel File",
      "action": "excel.read",
      "parameters": {
        "file_path": "${excel_path}",
        "clean_headers": true
      },
      "output_var": "challenge_data"
    },
    {
      "id": "step_3",
      "name": "Click START Button to Begin Timer",
      "action": "web.click",
      "parameters": {
        "selector": "button:has-text('Start')"
      }
    },
    {
      "id": "step_4",
      "name": "Loop Through 10 Rows and Fill Form",
      "action": "logic.loop",
      "parameters": {
        "items": "${challenge_data}",
        "item_var": "row"
      },
      "sub_steps": [
        {
          "id": "sub_4_1",
          "name": "Fill First Name",
          "action": "web.type",
          "parameters": {
            "label": "First Name",
            "text": "${row.First Name}"
          }
        },
        {
          "id": "sub_4_2",
          "name": "Fill Last Name",
          "action": "web.type",
          "parameters": {
            "label": "Last Name",
            "text": "${row.Last Name}"
          }
        },
        {
          "id": "sub_4_3",
          "name": "Fill Company Name",
          "action": "web.type",
          "parameters": {
            "label": "Company Name",
            "text": "${row.Company Name}"
          }
        },
        {
          "id": "sub_4_4",
          "name": "Fill Role in Company",
          "action": "web.type",
          "parameters": {
            "label": "Role in Company",
            "text": "${row.Role in Company}"
          }
        },
        {
          "id": "sub_4_5",
          "name": "Fill Address",
          "action": "web.type",
          "parameters": {
            "label": "Address",
            "text": "${row.Address}"
          }
        },
        {
          "id": "sub_4_6",
          "name": "Fill Email",
          "action": "web.type",
          "parameters": {
            "label": "Email",
            "text": "${row.Email}"
          }
        },
        {
          "id": "sub_4_7",
          "name": "Fill Phone Number",
          "action": "web.type",
          "parameters": {
            "label": "Phone Number",
            "text": "${row.Phone Number}"
          }
        },
        {
          "id": "sub_4_8",
          "name": "Submit Form Round",
          "action": "web.click",
          "parameters": {
            "selector": "//input[@value='Submit']"
          }
        }
      ]
    },
    {
      "id": "step_5",
      "name": "Read Congratulations Score Message",
      "action": "web.get_text",
      "parameters": {
        "selector": "//div[contains(@class, 'congratulations') or contains(@class, 'message2')]"
      },
      "output_var": "score_result"
    },
    {
      "id": "step_6",
      "name": "Take Screenshot of Result",
      "action": "web.screenshot",
      "parameters": {
        "path": "${screenshot_path}"
      }
    },
    {
      "id": "step_7",
      "name": "Close Browser",
      "action": "web.close",
      "parameters": {}
    }
  ]
}
