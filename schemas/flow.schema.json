{
  "$defs": {
    "ErrorHandlerConfig": {
      "properties": {
        "on_error": {
          "default": "stop",
          "description": "After the last attempt: fail (or stop, retry) or continue",
          "title": "On Error",
          "type": "string"
        },
        "max_retries": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Retry attempts before on_error decides; a number or ${...}",
          "title": "Max Retries"
        },
        "retry_interval": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": 1.0,
          "description": "Seconds to wait between attempts; a number or ${...}",
          "title": "Retry Interval"
        },
        "fallback_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Step ID to jump to upon error",
          "title": "Fallback Step Id"
        }
      },
      "title": "ErrorHandlerConfig",
      "type": "object"
    },
    "Step": {
      "properties": {
        "id": {
          "description": "Unique step identifier (e.g. step_1, sub_check_programmer)",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Human-readable name describing what this step does",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional detailed business intent or technical explanation",
          "title": "Description"
        },
        "action": {
          "description": "Action identifier (e.g. web.open, web.click, web.type, web.get_text, web.screenshot, web.close, excel.read, excel.write, logic.if, logic.loop, logic.append, logic.set_variable, logic.delay, flow.call, flow.return, email.send, http.request)",
          "title": "Action",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "description": "Key-value parameters passed to the action",
          "title": "Parameters",
          "type": "object"
        },
        "output_var": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Variable name to store the return value in context",
          "title": "Output Var"
        },
        "sub_steps": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Step"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Child steps for logic.loop or when logic.if evaluates to true",
          "title": "Sub Steps"
        },
        "else_steps": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Step"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Child steps executed when logic.if evaluates to false",
          "title": "Else Steps"
        },
        "error_handler": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorHandlerConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Step-level error handling strategy"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional execution condition expression (e.g. '${row.Status} == Active')",
          "title": "Condition"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Line of the step heading in its flow.md, for error reports; not part of the compiled form",
          "title": "Line"
        }
      },
      "required": [
        "id",
        "name",
        "action"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "properties": {
    "name": {
      "description": "Name of the RPA automation flow",
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "High-level description of business purpose and scope",
      "title": "Description"
    },
    "version": {
      "default": "1.0.0",
      "description": "Semantic version of the flow definition",
      "title": "Version",
      "type": "string"
    },
    "variables": {
      "additionalProperties": true,
      "description": "Initial context variables accessible via ${var_name}",
      "title": "Variables",
      "type": "object"
    },
    "requires": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Kinenix version the flow needs, e.g. kinenix>=0.2.0b4",
      "title": "Requires"
    },
    "steps": {
      "description": "Sequential steps to execute",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "on_error_steps": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Steps of ## On Error: run once when Steps fail",
      "title": "On Error Steps"
    },
    "finally_steps": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Steps of ## Finally: run after Steps and On Error, always",
      "title": "Finally Steps"
    }
  },
  "required": [
    "name"
  ],
  "title": "Kinenix Flow Definition Schema",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
